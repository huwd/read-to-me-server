# Copy to .env and fill in. .env is ignored by git: never commit it.

# API bearer token, at least 32 characters. Generate one with:
#   openssl rand -hex 32
RTM_STATIC_TOKEN=

# How podcast apps reach this server; feed URLs are built from it. Use an address
# your phone can reach, e.g. http://192.168.1.10:8080 or your HTTPS hostname.
RTM_PUBLIC_URL=http://localhost:8080

# Where the server listens on the host. The default keeps it on this machine; use
# 0.0.0.0:8080 to serve your LAN, or put a TLS reverse proxy in front.
RTM_BIND=127.0.0.1:8080

# Narration voice: bf_emma, bf_isabella, bm_george, bm_lewis or af_heart.
RTM_TTS_VOICE=bf_emma

# Log filter, e.g. info or rtm_api=debug.
RTM_LOG=info

# Images. The defaults track main; pin a digest for a stable deployment.
# RTM_IMAGE=ghcr.io/huwd/read-to-me-server/rtm:edge
# RTM_TTS_IMAGE=ghcr.io/huwd/read-to-me-server/tts:edge
